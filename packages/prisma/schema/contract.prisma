  expires    Timestamp3

  @@unique([identifier, token])

  @@map("EmailVerificationToken")
}

// Password reset tokens
model PasswordResetToken {
  id         String   @id @default(cuid(2))
  identifier String
  token      String   @unique
  expires    Timestamp3

  @@unique([identifier, token])

  @@map("PasswordResetToken")
}

model UtmTemplate {
  id   String @id @default(cuid(2))
  name String

